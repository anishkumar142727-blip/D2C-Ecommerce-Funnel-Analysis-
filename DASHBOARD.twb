      <column caption='1. Visited' datatype='integer' name='[Calculation_2719394462466051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [visited_website] = &apos;Yes&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='2. Viewed' datatype='integer' name='[Calculation_2719394462580740]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [viewed_product] = &apos;Yes&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='3. Added to cart' datatype='integer' name='[Calculation_2719394462683141]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [added_to_cart] = &apos;Yes&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='4. Check out started' datatype='integer' name='[Calculation_2719394462760966]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [checkout_started] = &apos;Yes&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='5. Purchased' datatype='integer' name='[Calculation_2719394462883847]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [purchase_completed] = &apos;Yes&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Conversion%' datatype='real' name='[Calculation_2719394482053129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [purchase_completed] = &apos;Yes&apos; THEN 1 ELSE 0 END) / COUNT([session_id])' />
      </column>
